{
  "name": "mcts-urgences",
  "version": "0.1.0",
  "private": true,
  "description": "Un assistant d'organisation pour les urgences d'un hôpital en crise : ISMCTS / POMCP sur l'état caché des patients.",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run types && npm test",
    "compare": "node scripts/compare.js",
    "pathway": "node scripts/pathway-compare.js",
    "page": "node node_modules/mcts-commun/bin/serve.js 4801",
    "types": "tsc -p .",
    "prepare": "git config core.hooksPath .githooks",
    "changelog": "node scripts/changelog.js",
    "fatigue": "node scripts/fatigue-compare.js",
    "pathway:search": "node scripts/pathway-search-compare.js",
    "pathway:additions": "node scripts/additions-compare.js"
  },
  "author": "Sami",
  "license": "UNLICENSED",
  "dependencies": {
    "mcts-commun": "file:../mcts-commun"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.12.0",
    "typescript": "^5.9.3"
  }
}
