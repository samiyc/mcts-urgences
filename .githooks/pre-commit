#!/bin/sh
# Before each commit (Sami, 26/10/2026): the lint, the types and the tests, as `npm run check`, the tests in short.
# A failure stops the commit: fix it, never skip it. Enabled by `git config core.hooksPath .githooks`, which
# `npm install` sets (the prepare script). The tests run 4 files at once at most (Sami, 28/10/2026: a --slot takes 4
# threads at most); TEST_CONCURRENCY=2 (say) runs fewer, while measures take the machine's threads (18 at most).
npm run --silent lint && npm run --silent types && node --test --test-reporter=dot --test-concurrency=${TEST_CONCURRENCY:-4}
