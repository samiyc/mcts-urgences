{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable", "webworker.importscripts"],
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "preserveSymlinks": true
  },
  "include": ["src/**/*.js", "web/**/*.js", "scripts/**/*.js"]
}
